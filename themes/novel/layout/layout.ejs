<!DOCTYPE html>
<html lang="<%= config.language || 'zh-CN' %>">
<%- partial('_partial/head') %>
<% 
  var isPoetryPage = false;
  if (page.tags && page.tags.length) {
    page.tags.each(function (t) { if (t.name === (theme.poetry_tag || '诗歌')) isPoetryPage = true; });
  }
  var pageCover = (page.cover && String(page.cover).trim()) || '';
%>
<body class="novel-body<% if (page.layout === 'home') { %> novel-body--home<% } %><% if (isPoetryPage) { %> novel-body--poetry<% } %>"<% if (pageCover) { %> style="--novel-duck-bg-image:url('<%- url_for(pageCover) %>')"<% } %>>
  <% if (page.layout !== 'home') { %>
  <div class="novel-read-progress" id="read-progress" aria-hidden="true"></div>
  <%- partial('_partial/header') %>
  <div class="novel-wrap">
    <%- body %>
  </div>
  <%- partial('_partial/footer') %>
  <% } else { %>
  <%- body %>
  <% } %>
  <div class="novel-theme-flash" id="novel-theme-flash" aria-hidden="true"></div>
  <script src="<%- url_for('/js/novel.js') %>"></script>
</body>
</html>
